<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_standard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="0px"
    android:paddingBottom="0px"
    android:paddingStart="0px"
    android:paddingEnd="0px"
    android:clipChildren="true"
    android:clipToPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="30px"
        android:paddingEnd="30px"
        android:paddingTop="36px"
        android:paddingBottom="36px"
        android:background="@drawable/widget_today_course_background">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="12px"
            android:layout_marginEnd="12px"
            android:layout_marginBottom="24px">

            <ImageView
                android:layout_width="48px"
                android:layout_height="48px"
                android:src="@drawable/ic_miuix_logo"
                android:scaleY="-1"
                android:alpha="0.8"
                android:layout_marginEnd="18px" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="42px"
                android:textStyle="bold"
                android:textColor="@color/widget_title_color"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="42px"
                android:textColor="@color/widget_title_color"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Course content -->
        <LinearLayout
            android:id="@+id/widget_course_content"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="bottom"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_course_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="51px"
                android:textColor="@color/widget_name_color"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingStart="12px"
                android:paddingBottom="12px"
                android:layout_marginBottom="12px" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="12px"
                android:layout_marginBottom="6px">

                <ImageView
                    android:layout_width="36px"
                    android:layout_height="36px"
                    android:src="@drawable/ic_widget_clock"
                    android:layout_marginEnd="18px" />

                <TextView
                    android:id="@+id/widget_course_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="42px"
                    android:textColor="@color/widget_time_end_color"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="12px"
                android:layout_marginBottom="48px">

                <ImageView
                    android:layout_width="36px"
                    android:layout_height="36px"
                    android:src="@drawable/ic_widget_location"
                    android:layout_marginEnd="18px" />

                <TextView
                    android:id="@+id/widget_course_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="42px"
                    android:textColor="@color/widget_time_end_color"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Remaining courses info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="12px">

                <TextView
                    android:id="@+id/widget_remaining_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="36px"
                    android:textColor="@color/widget_time_end_color"
                    android:fontFamily="sans-serif" />

                <ImageView
                    android:id="@+id/widget_dot1"
                    android:layout_width="21px"
                    android:layout_height="21px"
                    android:layout_marginStart="12px"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_dot2"
                    android:layout_width="21px"
                    android:layout_height="21px"
                    android:layout_marginStart="12px"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_dot3"
                    android:layout_width="21px"
                    android:layout_height="21px"
                    android:layout_marginStart="12px"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_dot4"
                    android:layout_width="21px"
                    android:layout_height="21px"
                    android:layout_marginStart="12px"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_dot5"
                    android:layout_width="21px"
                    android:layout_height="21px"
                    android:layout_marginStart="12px"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_dot6"
                    android:layout_width="21px"
                    android:layout_height="21px"
                    android:layout_marginStart="12px"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_dot7"
                    android:layout_width="21px"
                    android:layout_height="21px"
                    android:layout_marginStart="12px"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/widget_dot8"
                    android:layout_width="21px"
                    android:layout_height="21px"
                    android:layout_marginStart="12px"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日无课"
                android:textSize="42px"
                android:textColor="@color/widget_empty_color" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
