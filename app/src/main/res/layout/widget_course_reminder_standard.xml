<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_standard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="0px"
    android:paddingBottom="0px"
    android:paddingStart="0px"
    android:paddingEnd="0px"
    android:clipChildren="true"
    android:clipToPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="33px"
        android:paddingEnd="33px"
        android:paddingTop="27px"
        android:paddingBottom="9px"
        android:background="@drawable/widget_background">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="12px"
            android:layout_marginEnd="12px"
            android:layout_marginBottom="24px">

            <ImageView
                android:layout_width="48px"
                android:layout_height="48px"
                android:src="@drawable/ic_miuix_logo"
                android:scaleY="-1"
                android:alpha="0.8"
                android:layout_marginEnd="18px" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0px"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="42px"
                android:textStyle="bold"
                android:textColor="@color/widget_title_color"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/widget_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="42px"
                android:textColor="@color/widget_title_color"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- Course card 1 -->
        <LinearLayout
            android:id="@+id/widget_course1"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_background"
            android:paddingStart="36px"
            android:paddingEnd="36px"
            android:paddingTop="12px"
            android:paddingBottom="12px"
            android:layout_marginBottom="24px"
            android:clipChildren="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginEnd="30px">

                <TextView
                    android:id="@+id/widget_time_start1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="36px"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/widget_time_start_color"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/widget_time_end1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="36px"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/widget_time_end_color"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_color1"
                android:layout_width="12px"
                android:layout_height="match_parent"
                android:layout_marginTop="18px"
                android:layout_marginBottom="18px"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="30px">

                <TextView
                    android:id="@+id/widget_name1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="42px"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_name_color"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_info1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6px"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="36px"
                    android:textColor="@color/widget_time_end_color"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_now1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="42px"
                android:textColor="@color/widget_now_color"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Course card 2 -->
        <LinearLayout
            android:id="@+id/widget_course2"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_background"
            android:paddingStart="36px"
            android:paddingEnd="36px"
            android:paddingTop="12px"
            android:paddingBottom="12px"
            android:layout_marginBottom="24px"
            android:clipChildren="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginEnd="30px">

                <TextView
                    android:id="@+id/widget_time_start2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="36px"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/widget_time_start_color"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/widget_time_end2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="36px"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/widget_time_end_color"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_color2"
                android:layout_width="12px"
                android:layout_height="match_parent"
                android:layout_marginTop="18px"
                android:layout_marginBottom="18px"
                android:scaleType="fitXY" />

            <LinearLayout
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="30px">

                <TextView
                    android:id="@+id/widget_name2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="42px"
                    android:textColor="@color/widget_name_color"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_info2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6px"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="36px"
                    android:textColor="@color/widget_time_end_color"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_now2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="42px"
                android:textColor="@color/widget_now_color"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日无课"
                android:textSize="42px"
                android:textColor="@color/widget_empty_color" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
