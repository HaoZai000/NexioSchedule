<?xml version="1.0" encoding="utf-8"?>
<!--
    Activity 嵌入分屏配置
    - splitMinWidthDp=600：宽度达到 600dp（平板/大屏）才分屏，手机自动堆叠
    - clearTop=true：右侧新开 Activity 时清掉旧 secondary，避免右栏无限叠加
    - finishSecondaryWithPrimary=always：左侧我的页关闭时右侧也关闭
    - 手机端不受此配置影响，二级→三级仍有 push 视差
-->
<resources xmlns:window="http://schemas.android.com/apk/res-auto">

    <!-- ===== 我的页 → 二级页面 ===== -->
    <SplitPairRule
        window:splitRatio="0.34"
        window:splitMinWidthDp="600"
        window:finishPrimaryWithSecondary="never"
        window:finishSecondaryWithPrimary="always"
        window:clearTop="true"
        window:splitOpenAnimation="systemDefault"
        window:splitChangeAnimation="systemDefault"
        window:splitCloseAnimation="systemDefault">

        <!-- 二级页面：从我的页直接启动 -->
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.CourseTimeSettingsActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.CourseReminderActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.WidgetIntroActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.AiImportActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.EducationalImportActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.BackupAndMigrationActivity" />
        <!-- 设置页实际启动的是这三个壳页类名，漏登记会导致右栏不进分屏而无限叠 Activity -->
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.ScheduleImportActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.ScheduleExportActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.ScheduleBackupActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.PreferenceSettingsActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.AboutActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.CourseManageActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.HolidaySettingsActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.SwitchScheduleActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.CommunicationActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.WebDavSettingsActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.LocalBackupActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.UpdateSettingsActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.AppreciateAuthorActivity" />
        <SplitPairFilter
            window:primaryActivityName=".ui.activities.MainActivity"
            window:secondaryActivityName=".ui.activities.ChangelogActivity" />
    </SplitPairRule>

</resources>