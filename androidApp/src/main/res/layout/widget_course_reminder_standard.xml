                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14dp"
                android:textColor="@color/widget_now_color"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Course card 4（4 格高起显示） -->
        <LinearLayout
            android:id="@+id/widget_course4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/widget_card_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginBottom="8dp"
            android:clipChildren="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start"
                android:layout_marginEnd="10dp">

                <TextView
                    android:id="@+id/widget_time_start4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/widget_time_start_color"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/widget_time_end4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12dp"
