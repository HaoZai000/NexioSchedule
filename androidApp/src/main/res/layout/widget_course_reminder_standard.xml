                android:layout_height="wrap_content"
                android:textSize="14dp"
                android:textColor="@color/widget_now_color"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Course card 3（3 格高起显示） -->
