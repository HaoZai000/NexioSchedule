	 <!-- 编辑页遮罩：已废弃（编辑页用灰白底, 不再需要暗色遮罩） -->
        <Rectangle x="#view_width/2" y="#view_height/2" align="center" alignV="center" fillColor="#80000000" w="#view_width" h="#view_height" visibility="0"/>

        <!-- ─── 今日课程 内容 ─── -->
        <Group h="#view_height" layered="true" w="#view_width">

            <!-- ═────── 标题栏 ═────── -->
            <Text textExp="@state_title" x="42" y="53" size="37" color="@titleColor" alignV="center" fontFamily="mipro-medium" />
            <Text textExp="@state_week_text" x="398" y="53" size="37" color="@titleColor" align="right" alignV="center" fontFamily="mipro-medium" />

            <!-- ═══════ 课程卡片背景（正在上课→半透蓝, 普通→浅色底; 编辑页→半透灰白卡片） ═══════ -->
            <Rectangle x="24" y="96" w="392" h="150"
                fillColor="@cardBg0" alpha="ifelse(#isInPicker,ifelse(#course_is_now[0]==1,26,40),ifelse(#course_is_now[0]==1,26,12))" cornerRadiusExp="40" cornerRadius="40"
                visibility="gt(#today_count,0)" />
            <Rectangle x="24" y="266" w="392" h="150"
                fillColor="@cardBg1" alpha="ifelse(#isInPicker,ifelse(eq(num(#course_is_now[1]),1),26,40),ifelse(eq(num(#course_is_now[1]),1),26,12))" cornerRadiusExp="40" cornerRadius="40"
                visibility="gt(#today_count,0)" />

            <!-- ═────── 课程行1（胶囊色条 + 课程信息右侧） ═────── -->
            <Group visibility="le(1,#today_count)">
                <!-- 课程信息（右侧） -->
                <Group x="76" y="134" w="340" h="140">
                    <!-- 课程名称（限单行, 超长省略） -->
                    <Text textExp="@course_name[0]" x="0" y="0" size="38"
                        color="@textColor" alignV="center" align="left" fontFamily="mipro-medium" />
                    <!-- 时间范围（第2行） -->
                    <Text textExp="@course_time_range[0]" x="0" y="42" size="32"
                        color="@subTextColor" align="left" alignV="center" fontFamily="mipro-medium" />
                    <!-- 地点｜教师（第3行） -->
                    <Text textExp="@course_location_teacher[0]" x="0" y="76" size="32"
                        color="@subTextColor" align="left" alignV="center" fontFamily="mipro-medium" />
                </Group>
            </Group>

            <!-- ═────── 课程行2（胶囊色条 + 课程信息右侧） ═────── -->
            <Group visibility="le(2,#today_count)">
                <!-- 课程信息（右侧） -->
                <Group x="76" y="304" w="340" h="140">
                    <!-- 课程名称（限单行, 超长省略） -->
                    <Text textExp="@course_name[1]" x="0" y="0" size="38"
                        color="@textColor" alignV="center" align="left" fontFamily="mipro-medium" />
                    <!-- 时间范围（第2行） -->
                    <Text textExp="@course_time_range[1]" x="0" y="42" size="32"
                        color="@subTextColor" align="left" alignV="center" fontFamily="mipro-medium" />
                    <!-- 地点｜教师（第3行） -->
                    <Text textExp="@course_location_teacher[1]" x="0" y="76" size="32"
                        color="@subTextColor" align="left" alignV="center" fontFamily="mipro-medium" />
                </Group>
            </Group>

            <!-- ═────── 空状态（本日/明日无课, 文案来自 /state） ═────── -->
            <Text textExp="@state_empty_text" x="#view_width/2" y="#view_height/2" size="37"
                color="@subTextColor" align="center" alignV="center" visibility="le(num(#today_count),0)" />

            <!-- 胶囊色条（在内容之后绘制，保持垂直居中） -->
            <Rectangle x="45" y="129" w="8" h="84"
                fillColor="@course_color_0" cornerRadiusExp="16" cornerRadius="16" visibility="le(1,#today_count)" />
            <Rectangle x="45" y="299" w="8" h="84"
                fillColor="@course_color_1" cornerRadiusExp="16" cornerRadius="16" visibility="le(2,#today_count)" />
        </Group>

        <!-- 点击 → 打开 Nexio 课程表 -->
        <Button x="0" y="0" w="#view_width" h="#view_height" contentDescriptionExp="@state_title+' '+num(#today_count)+' 节'">
            <Triggers>
                <Trigger action="up" condition="!eqs(@isPreviewMode,'true')">
                    <IntentCommand package="com.haooz.chedule" class="com.haooz.chedule.ui.activities.MainActivity" action="android.intent.action.MAIN" />
                </Trigger>
            </Triggers>
        </Button>
    </Layer>
</Widget>
