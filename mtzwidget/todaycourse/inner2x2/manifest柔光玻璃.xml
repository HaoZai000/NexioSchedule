  <!-- 融合玻璃参数（深色壁纸）：Glass_Bionic_Medium_Regular -->
  <Var name="bionic_dark_glass_params" type="number[]"
    values="
    0.5,1.5,0.5,1.4,
    0.16,
    1.5,
    0.2,
    0.3,
    0.2,0.8,
    0,
    1,1,1,0.1,
    0,
    0.2,
    1.4,
    1,
    36,
    2.2,
    80,
    200,
    1,
    0.8,
    -0.4,0.6,-0.8,
