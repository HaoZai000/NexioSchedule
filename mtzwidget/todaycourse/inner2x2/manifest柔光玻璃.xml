    <ViewOutlineProvider type="rect" left="0" top="0" right="#view_width" bottom="#view_height" radius="ifelse(eqs(@isPreviewMode,'true'),0,ifelse(#widget_radius,(#widget_radius / #__scale_factor),60))" />
    <!-- 降级背景色（高级材质关闭时显示; 编辑页时全不透明灰白底） -->
    <Rectangle x="#view_width/2" y="#view_height/2" w="#view_width" h="#view_height" align="center" alignV="center" fillColor="@bgColor" alpha="ifelse(#isInPicker,255,30)" cornerRadiusExp="ifelse(num(@__hyper_os_version_code) { 4,60,0)" cornerRadius="60" visibility="#showBg"/>
	
		
