<?xml version="1.0" encoding="UTF-8"?>
<Widget version="2" frameRate="0" screenWidth="1080" useVariableUpdater="DateTime.Minute" useHardwareCanvas="true" disableCutRoundCorner="false" customizedDarkModeWallpaper="true" supportBackgroundBlur="true">
    <!-- ═══════════════ 全局 ═══════════════ -->
    <ExternalCommands>
        <Trigger action="init,resume">
    <!-- 切屏时提高帧率，供动画或者数据刷新使用 -->
            <AnimationCommand target="fra" command="play" />
            <FrameRateCommand rate="60" condition="eqs(@isPreviewMode,'true')"/>
            <AnimationCommand target="fra" command="play" condition="!eqs(@isPreviewMode,'true')"/>
            <BinderCommand name="calendarEvents" command="refresh" delay="10" />
        </Trigger>
        <!-- 旋转/翻折 → 重新测量 -->
        <Trigger action="orientationChange">
            <MethodCommand target="__objRoot" targetType="var" method="selfResume" />
        </Trigger>

        <Trigger action="init">
            <BinderCommand name="displayCourses" command="refresh" delay="120" />
            <BinderCommand name="courseState" command="refresh" delay="120" />
        </Trigger>
        <Trigger action="resume">
            <ExternCommand command="__datatimeVarUpdate" strPara="'DateTime.Minute'" delay="100" />
            <BinderCommand name="displayCourses" command="refresh" />
            <BinderCommand name="courseState" command="refresh" />
        </Trigger>
    </ExternalCommands>
    <!-- 前台时每分钟主动刷新课程数据 -->
    <Var name="minute_watch" expression="#minute" threshold="1">
        <Trigger>
            <BinderCommand name="displayCourses" command="refresh" />
            <BinderCommand name="courseState" command="refresh" />
            <BinderCommand name="calendarEvents" command="refresh"/>
        </Trigger>
    </Var>
    <Var name="sx" expression="#view_width/344" />
    <Var name="sy" expression="#view_height/165" />
    <Var name="sr" expression="min(#view_width/344,#view_height/160)" />
    <Var name="widget_module_index" expression="'assets/clock/thumbnail.png'" const="true" type="string" />
  
    <Var name="fallback_bg" expression="ifelse(#__darkmode==0,'#FFFFFF','#1A1A1B')" type="string" />

    <!-- 今天/明天偏移量 -->
    <Var name="today_offset" expression="0" type="number" />

    <!-- 根据课程索引计算颜色（使用预设颜色列表） -->
    <Var name="course_color_0" expression="ifelse(#course_color_index[0]==1,'#2196F3',ifelse(#course_color_index[0]==2,'#FF9800',ifelse(#course_color_index[0]==3,'#F44336',ifelse(#course_color_index[0]==4,'#E6B422',ifelse(#course_color_index[0]==5,'#E91E63',ifelse(#course_color_index[0]==6,'#00BCD4',ifelse(#course_color_index[0]==7,'#3F51B5',ifelse(#course_color_index[0]==8,'#AB47BC',ifelse(#course_color_index[0]==9,'#009688','#4CAF50')))))))))" type="string" />
    <Var name="course_color_1" expression="ifelse(#course_color_index[1]==1,'#2196F3',ifelse(#course_color_index[1]==2,'#FF9800',ifelse(#course_color_index[1]==3,'#F44336',ifelse(#course_color_index[1]==4,'#E6B422',ifelse(#course_color_index[1]==5,'#E91E63',ifelse(#course_color_index[1]==6,'#00BCD4',ifelse(#course_color_index[1]==7,'#3F51B5',ifelse(#course_color_index[1]==8,'#AB47BC',ifelse(#course_color_index[1]==9,'#009688','#4CAF50')))))))))" type="string" />

    <!-- 卡片背景色/透明度（fillColor 用 6 位色 Var 再单独传 alpha, 与全项目一致; 正在上课→半透蓝, 普通→textColor 语义） -->
    <Var name="cardBg0" expression="ifelse(#course_is_now[0]==1,'#2196F3',ifelse(#isInPicker,'#FFFFFF',ifelse(#isBionic,'#FFFFFF',ifelse(#__darkmode,'#FFFFFF','#000000'))))" type="string" />
    <Var name="cardBg1" expression="ifelse(#course_is_now[1]==1,'#2196F3',ifelse(#isInPicker,'#FFFFFF',ifelse(#isBionic,'#FFFFFF',ifelse(#__darkmode,'#FFFFFF','#000000'))))" type="string" />

    <!-- 预设课程颜色列表（与 App 一致） -->
    <Var name="preset_colors" type="string[]" values="#4CAF50,#2196F3,#FF9800,#F44336,#E6B422,#E91E63,#00BCD4,#3F51B5,#AB47BC,#009688,#673AB7" const="true" />

    <!-- 时间格式化 -->
    <Var name="Star_Time" expression="''" values="formatDate('HH:mm',@calendar_dtstart[0]),formatDate('HH:mm',@calendar_dtstart[1])" type="string[]" />
    <Var name="End_Time" expression="''" values="formatDate('HH:mm',@calendar_dtend[0]),formatDate('HH:mm',@calendar_dtend[1])" type="string[]" />

    <!-- 日程类型 -->
    <Var name="events_Type" expression="''" values="ifelse(eq(@calendar_hasExtendedProperties[0],9),'倒数日',eq(@calendar_hasExtendedProperties[0],8),'纪念日',eq(@calendar_hasExtendedProperties[0],7),'生日',eq(@calendar_hasExtendedProperties[0],0),'日程','无类型'),ifelse(eq(@calendar_hasExtendedProperties[1],9),'倒数日',eq(@calendar_hasExtendedProperties[1],8),'纪念日',eq(@calendar_hasExtendedProperties[1],7),'生日',eq(@calendar_hasExtendedProperties[1],0)==0,'日程','无类型')" type="string[]" />

    <!-- 今天0点时间戳 -->
    <Var name="current_day_start" expression="#time_sys - #time_sys%86400000" type="number" const="false" />
    <!-- 今天24点时间戳 -->
    <Var name="current_day_end" expression="#current_day_start + 86400000" type="number" const="false" />

    <!-- ══════════════════════════════════════════════════════════════
         数据绑定
         ══════════════════════════════════════════════════════════════ -->
    <VariableBinders>
        <!-- 深色模式切换 → 强制刷新 -->
        <BroadcastBinder action="android.intent.action.CONFIGURATION_CHANGED">
            <Trigger>
                <MethodCommand target="__objRoot" targetType="var" method="selfResume" />
            </Trigger>
        </BroadcastBinder>

        <!-- ═══════ 今日课程 · 展示课程数据源（/display 已按今日/明日自动解析, 只读） ═══════ -->
        <ContentProviderBinder name="displayCourses" uri="content://com.haooz.chedule.courses/display"
            columns="id,name,classroom,teacher,section_text,start_time,end_time,color,color_index,row_bg,sub_text,sub_color,is_now,remaining_text"
            column="name" countName="today_count">
            <Variable name="course_id" column="id" type="string[]" />
            <Variable name="course_name" column="name" type="string[]" />
            <Variable name="course_classroom" column="classroom" type="string[]" />
            <Variable name="course_teacher" column="teacher" type="string[]" />
            <Variable name="course_section" column="section_text" type="string[]" />
            <Variable name="course_start_time" column="start_time" type="string[]" />
            <Variable name="course_end_time" column="end_time" type="string[]" />
            <Variable name="course_color" column="color" type="string[]" />
            <Variable name="course_color_index" column="color_index" type="number[]" />
            <Variable name="course_row_bg" column="row_bg" type="string[]" />
            <Variable name="course_sub_text" column="sub_text" type="string[]" />
            <Variable name="course_sub_color" column="sub_color" type="string[]" />
            <Variable name="course_is_now" column="is_now" type="number[]" />
            <Variable name="course_remaining_text" column="remaining_text" type="string[]" />
        </ContentProviderBinder>

        <!-- ═══════ 今日课程 · 状态数据源（标题/周状态/空态文案, 只读） ═══════ -->
        <ContentProviderBinder name="courseState" uri="content://com.haooz.chedule.courses/state"
            columns="title,week_text,empty_text,show_tomorrow"
            column="title" countName="state_count">
            <Variable name="state_title" column="title" type="string" />
            <Variable name="state_week_text" column="week_text" type="string" />
            <Variable name="state_empty_text" column="empty_text" type="string" />
            <Variable name="state_show_tomorrow" column="show_tomorrow" type="string" />
        </ContentProviderBinder>

        <!-- 日程数据源 -->
        <ContentProviderBinder name="calendarEvents" uri="content://com.android.calendar/events" whereFormat="((dtstart&gt;='%d' AND dtstart&lt;='%d') OR (dtstart&lt;'%d' AND dtend&gt;='%d')) AND deleted=='%d' AND dtend&gt;='%d'" whereParas="#current_day_start,#current_day_end,#current_day_start,#current_day_start,0,#current_time" countName="events">
            <!-- 标题 -->
            <Variable name="calendar_title" type="string[]" column="title"/>
            <!-- 地点，没有则为null -->
            <Variable name="calendar_eventLocation" type="string[]" column="eventLocation"/>
            <!-- 提醒开始时间-->
            <Variable name="calendar_dtstart" type="string[]" column="dtstart"/>
            <!-- 提醒结束时间 -->
            <Variable name="calendar_dtend" type="string[]" column="dtend"/>
            <!-- 全天事件 -->
            <Variable name="calendar_allDay" type="string[]" column="allDay"/>
            <!-- 事件的最后时间, 空表示无限 -->
            <Variable name="calendar_lastDate" type="string[]" column="lastDate"/>
            <!-- 是否被删除 -->
            <Variable name="calendar_deleted" type="string[]" column="deleted"/>
            <!-- 日程的类型 -->
            <Variable name="calendar_hasExtendedProperties" type="string[]" column="hasExtendedProperties"/>
            <!-- 日程id -->
            <Variable name="calendar_id" type="string[]" column="_id"/>
            <!-- 持续时间 -->
            <Variable name="calendar_duration" type="string[]" column="duration"/>
        </ContentProviderBinder>
    </VariableBinders>

    <!-- ═══════════════ 统一帧率控制 ═══════════════ -->
    <!-- 帧率调整//推荐写法//通过FunctionCommand命令在init,resume时调用 -->
    <Group name="frameRateSetting">
        <Function name="fra">
            <IfCommand ifCondition="eqs(@isPreviewMode,'true')">
                <Consequent>
                    <FrameRateCommand rate="60" />
                </Consequent>
                <Alternate>
                    <AnimationCommand target="frame" command="play"/>
                </Alternate>
            </IfCommand>
        </Function>
        <FramerateController name="frame" initPause="true" loop="false">
            <ControlPoint frameRate="60" time="0" />
            <ControlPoint frameRate="60" time="300" />
            <ControlPoint frameRate="0" time="1000" />
        </FramerateController>
    </Group>
    <!-- UI布局 -->

    <Var name="textColor" type="string" expression="ifelse(#isInPicker,'#000000',ifelse(#isBionic,'#FFFFFF',ifelse(#__darkmode,'#FFFFFF','#000000')))"/>
    <Var name="titleColor" type="string" expression="ifelse(#isInPicker,'#BF000000',ifelse(#isBionic,'#BFFFFFFF',ifelse(#__darkmode,'#BFFFFFFF','#BF000000')))"/>
    <Var name="bgColor" type="string" expression="ifelse(#applied_light_wallpaper,'#FF000000','#FFffffff')"/>

		
  <Var name="isDark" type="number" expression="#__darkmode" />
  <!-- 高级材质变量 -->
  <Var name="isGlassBionic" type="number" expression="#glass_type[0]" />
  <Var name="isBionic" type="number" expression="#isGlassBionic ** #hyper_material_glass_enable ** (! #isInPicker) ** (#hyper_material_view_type==1)" />
  <Var name="showBg" type="number" expression="not(#enable_hyper_material) || #isInPicker || (#hyper_material_view_type==2)" />
  <Var name="bgColor" type="string" expression="ifelse(#isInPicker,'#FFF5F5F5',ifelse(#isDark,'#FF1A1A1B','#FFFFFFFF'))" />

    <!-- ═══════ 今日课程 · 内容用色 ═══════ -->
    <Var name="subTextColor" type="string" expression="ifelse(#isInPicker,'#55000000',ifelse(#isBionic,'#99FFFFFF',ifelse(#__darkmode,'#73FFFFFF','#55000000')))" />
    <Var name="timeColor" type="string" expression="ifelse(#isInPicker,'#88000000',ifelse(#isBionic,'#CCFFFFFF',ifelse(#__darkmode,'#99FFFFFF','#88000000')))" />
    <Var name="dividerColor" type="string" expression="'#33FFFFFF'" />

    <!-- ═══════ 今日课程 · 行数/计数 ═══════ -->
    <Var name="max_rows" type="number" const="true" expression="3" />

    <!-- 背景颜色 -->
    <Var name="bg_color" expression="ifelse(#__darkmode==1,'#3E3A39','#FFFFFF')" type="string" />
    <!-- 视觉层 -->
   <Rectangle x="0" y="0" w="#view_width" h="#view_height" alpha="#set_alpha" fillColor="@bg_color" cornerRadius="46"/>
        <!-- ─── 今日课程 内容 ─── -->
        <Group h="#view_height" layered="true" w="#view_width" visibility="ifelse(#today_count==0,'0','1')">

            <!-- ═────── 标题栏 ═────── -->
            <Text textExp="ifelse(#today_offset==0,'今天 / ',ifelse(#today_offset==1,'明天 / ',''))+@state_title" x="20*#sx" y="20*#sy" size="14*#sx" color="@titleColor" alignV="center" fontFamily="mipro-medium" />
            <Text textExp="@state_week_text" x="(344-20)*#sx" y="20*#sy" size="14*#sx" color="@titleColor" align="right" alignV="center" fontFamily="mipro-medium" />

            <!-- ═══════ 课程卡片背景（正在上课→半透蓝, 普通→浅色底） ═══════ -->
            <Rectangle x="12*#sx" y="36*#sy" w="(344-24)*#sx" h="55*#sy"
                fillColor="@cardBg0" alpha="ifelse(#course_is_now[0]==1,26,12)" cornerRadiusExp="32" cornerRadius="32"
                visibility="gt(#today_count,0)" />
            <Rectangle x="12*#sx" y="98*#sy" w="(344-24)*#sx" h="55*#sy"
                fillColor="@cardBg1" alpha="ifelse(eq(num(#course_is_now[1]),1),26,12)" cornerRadiusExp="32" cornerRadius="32"
                visibility="gt(#today_count,0)" />

            <!-- ═────── 课程行1（时间左侧 + 胶囊色条 + 课程信息右侧） ═────── -->
            <Group visibility="le(1,#today_count)">
                <!-- 时间区域（左侧） -->
                <Text textExp="@course_start_time[0]" x="22*#sx" y="55*#sy" size="12*#sx"
                    color="@timeColor" align="left" alignV="center" fontFamily="mipro-medium" />
                <Text textExp="@course_end_time[0]" x="22*#sx" y="73*#sy" size="12*#sx"
                    color="@subTextColor" align="left" alignV="center" fontFamily="mipro-medium" />
                <!-- 课程信息（右侧） -->
                <Group x="70*#sx" y="55*#sy" w="262*#sx" h="32*#sy">
                    <!-- 课程名称（App 端已按容器宽度截断, 小部件不做截断） -->
                    <Text textExp="@course_name[0]" x="0*#sx" y="0*#sy" size="14*#sx"
                        color="@textColor" alignV="center" align="left" fontFamily="mipro-medium" />
                    <!-- 课程详情（App 端已按容器宽度截断, 小部件不做截断） -->
                    <Text textExp="@course_sub_text[0]" x="0*#sx" y="20*#sy" size="12*#sx"
                        color="@subTextColor" align="left" alignV="center" fontFamily="mipro-medium" />
                </Group>
                <!-- 倒计时（独立组件, 仅正在上课显示，最右侧） -->
                <Text textExp="@course_remaining_text[0]" x="(344-22)*#sx" y="64*#sy" size="14*#sx"
                    color="#2196F3" align="right" alignV="center" fontFamily="mipro-medium" fontWeight="medium"
                    visibility="eq(num(#course_is_now[0]),1)" />
            </Group>

            <!-- ═────── 课程行2（时间左侧 + 胶囊色条 + 课程信息右侧） ═────── -->
            <Group visibility="le(2,#today_count)">
                <!-- 时间区域（左侧） -->
                <Text textExp="@course_start_time[1]" x="22*#sx" y="117*#sy" size="12*#sx"
                    color="@timeColor" align="left" alignV="center" fontFamily="mipro-medium" />
                <Text textExp="@course_end_time[1]" x="22*#sx" y="135*#sy" size="12*#sx"
                    color="@subTextColor" align="left" alignV="center" fontFamily="mipro-medium" />
                <!-- 课程信息（右侧） -->
                <Group x="70*#sx" y="117*#sy" w="262*#sx" h="32*#sy">
                    <!-- 课程名称（App 端已按容器宽度截断, 小部件不做截断） -->
                    <Text textExp="@course_name[1]" x="0*#sx" y="0*#sy" size="14*#sx"
                        color="@textColor" alignV="center" align="left" fontFamily="mipro-medium" />
                    <!-- 课程详情（App 端已按容器宽度截断, 小部件不做截断） -->
                    <Text textExp="@course_sub_text[1]" x="0*#sx" y="20*#sy" size="12*#sx"
                        color="@subTextColor" align="left" alignV="center" fontFamily="mipro-medium" />
                </Group>
                <!-- 倒计时（独立组件, 仅正在上课显示，最右侧） -->
                <Text textExp="@course_remaining_text[1]" x="(344-22)*#sx" y="126*#sy" size="14*#sx"
                    color="#2196F3" align="right" alignV="center" fontFamily="mipro-medium" fontWeight="medium"
                    visibility="eq(num(#course_is_now[1]),1)" />
            </Group>

            <!-- ═────── 空状态（本日/明日无课, 文案来自 /state） ═────── -->
            <Text textExp="@state_empty_text" x="#view_width/2" y="#view_height/2+4*#sy" size="14*#sx"
                color="@subTextColor" align="center" alignV="center" visibility="le(num(#today_count),0)" />

            <!-- 胶囊色条（在内容之后绘制，保持垂直居中） -->
            <Rectangle x="60*#sx" y="48*#sy" w="3*#sx" h="32*#sy"
                fillColor="@course_color_0" cornerRadiusExp="16" cornerRadius="16" visibility="le(1,#today_count)" />
            <Rectangle x="60*#sx" y="110*#sy" w="3*#sx" h="32*#sy"
                fillColor="@course_color_1" cornerRadiusExp="16" cornerRadius="16" visibility="le(2,#today_count)" />
        </Group>

        <!-- ─── 日程 内容（empty_type!=0 无展示课程时显示，伪装成日历） ─── -->
        <Group h="#view_height" layered="true" w="#view_width" visibility="ifelse(#today_count==0,'1','0')">

            <!-- ═────── 标题栏 ═────── -->
            <Text text="今天" x="20*#sx" y="20*#sy" size="14*#sx" color="@titleColor" alignV="center" fontFamily="mipro-medium" />
            <DateTime format="E" x="(344-20)*#sx" y="20*#sy" size="14*#sx" color="@titleColor" align="right" alignV="center" fontFamily="mipro-medium" />

            <!-- ═══════ 课程卡片背景（正在上课→半透蓝, 普通→浅色底） ═══════ -->
            <Rectangle x="12*#sx" y="36*#sy" w="(344-24)*#sx" h="55*#sy"
                fillColor="#2196F3" alpha="26" cornerRadiusExp="32" cornerRadius="32"
                visibility="#events}=1" />
            <Rectangle x="12*#sx" y="98*#sy" w="(344-24)*#sx" h="55*#sy"
                fillColor="#2196F3" alpha="26" cornerRadiusExp="32" cornerRadius="32"
                visibility="#events==2" />

            <!-- ═────── 课程行1（时间左侧 + 胶囊色条 + 课程信息右侧） ═────── -->
            <Group visibility="#events}=1">
                <!-- 时间区域（左侧） -->
                <Text textExp="@Star_Time[0]" x="22*#sx" y="55*#sy" size="12*#sx" color="@timeColor" align="left" alignV="center" visibility="#events==1" fontFamily="mipro-medium" />
                <Text textExp="@Star_Time[1]" x="22*#sx" y="55*#sy" size="12*#sx" color="@timeColor" align="left" alignV="center" visibility="#events==2" fontFamily="mipro-medium" />
                <Text textExp="@End_Time[0]" x="22*#sx" y="73*#sy" size="12*#sx" color="@subTextColor" align="left" alignV="center" visibility="#events==1" fontFamily="mipro-medium" />
                <Text textExp="@End_Time[1]" x="22*#sx" y="73*#sy" size="12*#sx" color="@subTextColor" align="left" alignV="center" visibility="#events==2" fontFamily="mipro-medium" />
                <!-- 课程信息（右侧） -->
                <Group x="70*#sx" y="55*#sy" w="262*#sx" h="32*#sy">
                    <!-- 课程名称（App 端已按容器宽度截断, 小部件不做截断） -->
                    <Text textExp="@calendar_title[0]" width="450" marqueeSpeed="30" x="0*#sx" y="0*#sy" size="14*#sx" color="@textColor" alignV="center" align="left" visibility="#events==1" fontFamily="mipro-medium" />
                    <Text textExp="@calendar_title[1]" width="450" marqueeSpeed="30" x="0*#sx" y="0*#sy" size="14*#sx" color="@textColor" alignV="center" align="left" visibility="#events==2" fontFamily="mipro-medium" />
                    <!-- 课程详情（App 端已按容器宽度截断, 小部件不做截断） -->
                    <Text textExp="ifelse(strIsEmpty(@calendar_eventLocation[0]),'无地点',@calendar_eventLocation[0])" width="450" marqueeSpeed="30" x="0*#sx" y="20*#sy" size="12*#sx" color="@subTextColor" align="left" alignV="center" visibility="#events==1" fontFamily="mipro-medium" />
                    <Text textExp="ifelse(strIsEmpty(@calendar_eventLocation[1]),'无地点',@calendar_eventLocation[1])" width="450" marqueeSpeed="30" x="0*#sx" y="20*#sy" size="12*#sx" color="@subTextColor" align="left" alignV="center" visibility="#events==2" fontFamily="mipro-medium" />
                </Group>
                <!-- 倒计时（独立组件, 仅正在上课显示，最右侧） -->
                <Text textExp="@events_Type[0]" x="(344-22)*#sx" y="64*#sy" size="14*#sx"
                    color="#2196F3" align="right" alignV="center" fontFamily="mipro-medium" fontWeight="medium"
                    visibility="#events==1" />
                <Text textExp="@events_Type[1]" x="(344-22)*#sx" y="64*#sy" size="14*#sx"
                    color="#2196F3" align="right" alignV="center" fontFamily="mipro-medium" fontWeight="medium"
                    visibility="#events==2" />
            </Group>

            <!-- ═────── 课程行2（时间左侧 + 胶囊色条 + 课程信息右侧） ═────── -->
            <Group visibility="#events}=2">
                <!-- 时间区域（左侧） -->
                <Text textExp="@Star_Time[0]" x="22*#sx" y="117*#sy" size="12*#sx"
                    color="@timeColor" align="left" alignV="center" fontFamily="mipro-medium" />
                <Text textExp="@End_Time[0]" x="22*#sx" y="135*#sy" size="12*#sx"
                    color="@subTextColor" align="left" alignV="center" fontFamily="mipro-medium" />
                <!-- 课程信息（右侧） -->
                <Group x="70*#sx" y="117*#sy" w="262*#sx" h="32*#sy">
                    <!-- 课程名称（App 端已按容器宽度截断, 小部件不做截断） -->
                    <Text textExp="@calendar_title[0]" width="450" marqueeSpeed="30" x="0*#sx" y="0*#sy" size="14*#sx"
                        color="@textColor" alignV="center" align="left" fontFamily="mipro-medium" />
                    <!-- 课程详情（App 端已按容器宽度截断, 小部件不做截断） -->
                    <Text textExp="ifelse(strIsEmpty(@calendar_eventLocation[0]),'无地点',@calendar_eventLocation[0])" width="450" marqueeSpeed="30" x="0*#sx" y="20*#sy" size="12*#sx"
                        color="@subTextColor" align="left" alignV="center" fontFamily="mipro-medium" />
                </Group>
                <!-- 倒计时（独立组件, 仅正在上课显示，最右侧） -->
                <Text textExp="@events_Type[0]" x="(344-22)*#sx" y="126*#sy" size="14*#sx"
                    color="#2196F3" align="right" alignV="center" fontFamily="mipro-medium" fontWeight="medium"
                    visibility="#events==2" />
            </Group>

            <!-- ═────── 空状态（本日/明日无课, 文案来自 /state） ═────── -->
            <Text text="暂无日程" x="#view_width/2" y="#view_height/2+4*#sy" size="14*#sx"
                color="@subTextColor" align="center" alignV="center" visibility="#events==0" />

            <!-- 胶囊色条（在内容之后绘制，保持垂直居中） -->
            <Rectangle x="60*#sx" y="48*#sy" w="3*#sx" h="32*#sy"
                fillColor="#2196F3" cornerRadiusExp="16" cornerRadius="16" visibility="#events}=1" />
            <Rectangle x="60*#sx" y="110*#sy" w="3*#sx" h="32*#sy"
                fillColor="#2196F3" cornerRadiusExp="16" cornerRadius="16" visibility="#events}=2" />
        </Group>
        
        <!-- 点击 → 打开 日历 -->
        <Button x="0" y="0" w="#view_width" h="#view_height" visibility="ifelse(#today_count==0,'1','0')"> 
            <Triggers> 
            <Trigger action="up"> 
                <IntentCommand package="com.android.calendar" class="com.android.calendar.AllInOneActivity"/> 
                </Trigger> 
            </Triggers> 
        </Button>
        <!-- 点击 → 打开 Nexio 课程表 -->
        <Button x="0" y="0" w="#view_width" h="#view_height" visibility="ifelse(#today_count==0,'0','1')" contentDescriptionExp="@state_title+' '+num(#today_count)+' 节'">
            <Triggers>
                <Trigger action="up" condition="!eqs(@isPreviewMode,'true')">
                    <IntentCommand package="com.haooz.chedule" class="com.haooz.chedule.ui.activities.MainActivity" action="android.intent.action.MAIN" />
                </Trigger>
            </Triggers>
        </Button>
</Widget>
